<Window x:Class="MathGPT.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MathGPT · 安装配置" Width="880" Height="680" MinWidth="720" MinHeight="560" WindowStartupLocation="CenterScreen"
        Icon="Assets/MathGPT.ico" UseLayoutRounding="True" SnapsToDevicePixels="True" Style="{StaticResource {x:Type Window}}">
  <Window.Resources>
    <Style x:Key="NavigationButton" TargetType="Button">
      <Setter Property="MinHeight" Value="64"/><Setter Property="Padding" Value="12,0"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid Background="Transparent">
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Border x:Name="Selected" Height="3" CornerRadius="3,3,0,0" Margin="9,0,9,0" VerticalAlignment="Bottom" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Tag" Value="active"><Setter TargetName="Selected" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Selected" Property="Visibility" Value="Visible"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Background="{DynamicResource CanvasGlow}">
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <Grid Margin="24,0" MaxWidth="1480">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/MathGPT.png" Width="36" Height="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="MathGPT"/>
          <TextBlock x:Name="BrandName" Text="MathGPT" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" Margin="9,0,0,0"/>
        </StackPanel>
        <StackPanel x:Name="Navigation" Grid.Column="1" Orientation="Horizontal" Margin="22,0,0,0"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ThemeButton" Style="{StaticResource Ghost}" Click="ChooseAppearance" ToolTip="界面风格" Padding="8,7" Margin="0,0,1,0">
            <StackPanel Orientation="Horizontal"><ContentControl x:Name="ThemeIcon"/><TextBlock x:Name="ThemeName" Text="轻紫" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel>
          </Button>
          <Button x:Name="ModeButton" Style="{StaticResource Ghost}" Width="34" Padding="7" Click="ToggleMode" ToolTip="切换明暗"/>
          <Button x:Name="SiteButton" Content="打开网站 ↗" Style="{StaticResource Primary}" FontSize="12" Padding="12,7" Margin="10,0,0,0" MinHeight="32" Click="OpenSite"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" MaxWidth="1260" Margin="32,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="HeadingRegion" Margin="0,28,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Accent}" Width="4" Height="26" CornerRadius="3" VerticalAlignment="Top" Margin="0,5,0,0"/>
        <StackPanel Grid.Column="1" Margin="13,0,0,0">
          <TextBlock x:Name="PageTitle" FontSize="26" FontWeight="SemiBold" LineHeight="36"/>
          <TextBlock x:Name="PageSubtitle" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>
      <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,22">
        <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch"/>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,9,0,10">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="OperationText" Text="准备就绪" FontSize="11" Foreground="{DynamicResource Muted}"/><ProgressBar x:Name="OperationProgress" Height="3" Visibility="Collapsed" Margin="0,5,12,0" Maximum="100" Foreground="{DynamicResource Accent}"/></StackPanel>
          <TextBlock x:Name="VersionLabel" Grid.Column="1" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="16,0,0,0"/>
          <Button x:Name="CancelOperation" Grid.Column="2" Content="暂停 / 取消" Margin="12,0,0,0" Visibility="Collapsed" MinHeight="28" Padding="10,4" Click="CancelCurrent"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
